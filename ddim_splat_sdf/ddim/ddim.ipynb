   "source": [
    "# Define the device (GPU/CPU)\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# Load the saved UNet model\n",
    "unet = UNet2DModel.from_pretrained(\"/root/ddim/DDIM/unet\")\n",
    "unet.to(device)\n",
    "\n",
    "# Load the saved scheduler\n",
    "scheduler = DDIMScheduler.from_pretrained(\"/root/ddim/DDIM/scheduler\")"
   ]

    "up_arrow = '\\u2191'\n",
    "down_arrow = '\\u2193'\n",
    "def plot_metrics_with_labels(results, labels):\n",
    "    \"\"\"\n",
    "    Plots PSNR, SSIM, LPIPS, and FPS metrics from the results in two separate charts with custom x-axis labels.\n",
    "    \n",
    "    Args:\n",
    "        results (list of dict): List of dictionaries, each containing the metrics for each result set.\n",
    "        labels (list of str): List of labels for the x-axis (can include LaTeX for special symbols like lambda).\n",
    "    \"\"\"\n",
    "    \n",
    "    # Extracting metrics\n",
    "    psnr_values = [result['psnr'] for result in results]\n",
    "    ssim_values = [result['ssim'] for result in results]\n",
    "    lpips_values = [result['lpips'] for result in results]\n",
    "    fps_values = [result['fps'] for result in results]\n",
    "\n",
    "    # Use the first result as a baseline\n",
    "    baseline_psnr = psnr_values[0]\n",
    "    baseline_ssim = ssim_values[0]\n",
    "    baseline_lpips = lpips_values[0]\n",
    "    baseline_fps = fps_values[0]\n",
    "\n",
    "    # X-axis labels (for different results)\n",
    "    x_axis = np.arange(1, len(results) + 1)\n",
    "\n",
    "    # First Plot: PSNR and FPS\n",
    "    plt.figure(figsize=(10, 6))\n",
    "\n",
    "    # Plot PSNR line\n",
    "    plt.plot(x_axis, psnr_values, label='PSNR↑', marker='o', color='#FF5733')\n",
    "\n",
    "    # Plot FPS line\n",
    "    plt.plot(x_axis, fps_values, label='FPS↑', marker='o', color='#FFD700')\n",
    "\n",
    "    # Add baselines for the first result's values\n",
    "    plt.axhline(y=baseline_psnr, color='#FF5733', linestyle='--', label='Baseline PSNR', alpha=0.6)\n",
    "    plt.axhline(y=baseline_fps, color='#FFD700', linestyle='--', label='Baseline FPS', alpha=0.6)\n",
    "\n",
    "    # Add labels and legend\n",
    "    plt.xlabel('Result Set')\n",
    "    plt.ylabel('Metric Value')\n",
    "    plt.title('PSNR and FPS Across Different Results')\n",
    "    plt.xticks(x_axis, labels)\n",
    "    plt.legend()\n",
    "\n",
    "    # Show the first plot\n",
    "    plt.grid(True, axis='y', linestyle='--', alpha=0.7)\n",
    "    plt.show()\n",
    "\n",
    "    # Second Plot: SSIM and LPIPS\n",
    "    plt.figure(figsize=(10, 6))\n",
    "\n",
    "    # Plot SSIM line\n",
    "    plt.plot(x_axis, ssim_values, label='SSIM↑', marker='o', color='#33FF57')\n",
    "\n",
    "    # Plot LPIPS line\n",
    "    plt.plot(x_axis, lpips_values, label='LPIPS↓', marker='o', color='#3357FF')\n",
    "\n",
    "    # Add baselines for the first result's values\n",
    "    plt.axhline(y=baseline_ssim, color='#33FF57', linestyle='--', label='Baseline SSIM', alpha=0.6)\n",
    "    plt.axhline(y=baseline_lpips, color='#3357FF', linestyle='--', label='Baseline LPIPS', alpha=0.6)\n",
    "\n",
    "    # Add labels and legend\n",
    "    plt.xlabel('Result Set')\n",
    "    plt.ylabel('Metric Value')\n",
    "    plt.title('SSIM and LPIPS Across Different Results')\n",
    "    plt.xticks(x_axis, labels)\n",
    "    plt.legend()\n",
    "\n",
    "    # Show the second plot\n",
    "    plt.grid(True, axis='y', linestyle='--', alpha=0.7)\n",
    "    plt.show()"
   ]

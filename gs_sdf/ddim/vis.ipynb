    "import pandas as pd\n",
    "\n",
    "def create_styled_table(results, labels):\n",
    "    \"\"\"\n",
    "    Creates a styled table with conditional formatting based on PSNR, SSIM, and LPIPS values.\n",
    "    \n",
    "    Args:\n",
    "        results (list of dict): List of dictionaries, each containing the metrics for each result set.\n",
    "        labels (list of str): List of labels for the extraction methods.\n",
    "    \n",
    "    Returns:\n",
    "        df_styled: pandas Styler object for a formatted table\n",
    "    \"\"\"\n",
    "    \n",
    "    # Create a list of data from the results\n",
    "    data = [\n",
    "        [labels[i], results[i]['psnr'],results[i]['fps'], results[i]['ssim'], results[i]['lpips']] for i in range(len(results))\n",
    "    ]\n",
    "    \n",
    "    # Column names\n",
    "    columns = [\"Extraction method\", \"PSNR\",\"FPS\", \"SSIM\", \"LPIPS\"]\n",
    "\n",
    "    # Create a DataFrame\n",
    "    df = pd.DataFrame(data, columns=columns)\n",
    "    df = df.round(3)\n",
    "    # Round to 3 decimal places and format as strings to remove trailing zeros\n",
    "    df['PSNR'] = df['PSNR'].map('{:.3f}'.format)\n",
    "    df['FPS'] = df['FPS'].map('{:.3f}'.format)\n",
    "    df['SSIM'] = df['SSIM'].map('{:.3f}'.format)\n",
    "    df['LPIPS'] = df['LPIPS'].map('{:.3f}'.format)\n",
    "    # Highlight the maximum and minimum values in the relevant columns\n",
    "    def highlight_max(data, color='lightcoral'):\n",
    "        '''\n",
    "        Highlight the maximum in a Series\n",
    "        '''\n",
    "        attr = f'background-color: {color}'\n",
    "        is_max = data == data.max()\n",
    "        return [attr if v else '' for v in is_max]\n",
    "\n",
    "    def highlight_min(data, color='lightgreen'):\n",
    "        '''\n",
    "        Highlight the minimum in a Series\n",
    "        '''\n",
    "        attr = f'background-color: {color}'\n",
    "        is_min = data == data.min()\n",
    "        return [attr if v else '' for v in is_min]\n",
    "\n",
    "    # Apply conditional formatting\n",
    "    df_styled = df.style.apply(highlight_max, subset=['PSNR', 'FPS','SSIM']).apply(highlight_min, subset=['LPIPS'])\n",
    "    \n",
    "    return df_styled"
   ]
  },
